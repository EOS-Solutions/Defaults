<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://das.dogane.finanze.it" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://das.dogane.finanze.it" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="DAS_SimpleTypes.xsd"/>
	<!-- versione 1.0 del 03/07/2020 -->
	<xs:element name="DE810">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="annullamentoDas" type="AnnullamentoDas"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="AnnullamentoDas">
		<xs:sequence>
			<xs:element name="MessageCode" type="xs:string" fixed="DE810"/>
			<xs:element name="DeclaratorIdentifyCode">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[A-Z]{6}[0-9]{2}[A-Z]{1}[0-9]{2}[A-Z]{1}[0-9]{3}[A-Z]{1}|IT[0-9]{11}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Filename" type="an..25"/>
			<xs:element name="ConsignorExciseNumber">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="IT00[A-Z0-9]{9}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IdentifynumberSRC" type="an21Upper"/>
			<xs:element name="DeleateReasonCode" type="Int0-9"/>
			<xs:element name="ComplementaryInformation" type="an..350" minOccurs="0"/>
			<xs:element name="ComplementaryInformationLNG" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[a-z]{2}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
